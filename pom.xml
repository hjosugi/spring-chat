<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.hjosugi</groupId>
    <artifactId>spring-chat-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-chat</name>
    <description>An AI chat for Spring Boot and Thymeleaf, over SSE or WebSocket</description>
    <url>https://github.com/hjosugi/spring-chat</url>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/hjosugi/spring-chat</url>
        <connection>scm:git:https://github.com/hjosugi/spring-chat.git</connection>
        <developerConnection>scm:git:git@github.com:hjosugi/spring-chat.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/hjosugi/spring-chat/issues</url>
    </issueManagement>

    <modules>
        <module>spring-chat-spring-boot-autoconfigure</module>
        <module>spring-chat-spring-boot-starter</module>
        <module>spring-chat-sample-webmvc</module>
        <module>spring-chat-sample-webflux</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <deep-chat.version>2.5.1</deep-chat.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.hjosugi</groupId>
                <artifactId>spring-chat-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hjosugi</groupId>
                <artifactId>spring-chat-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.webjars.npm</groupId>
                <artifactId>deep-chat</artifactId>
                <version>${deep-chat.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>

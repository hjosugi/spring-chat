<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.hjosugi</groupId>
    <artifactId>spring-chat-parent</artifactId>
    <version>0.1.3-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-chat</name>
    <description>An AI chat for Spring Boot and Thymeleaf, over SSE or WebSocket</description>
    <url>https://github.com/hjosugi/spring-chat</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/hjosugi/spring-chat</url>
        <connection>scm:git:https://github.com/hjosugi/spring-chat.git</connection>
        <developerConnection>scm:git:git@github.com:hjosugi/spring-chat.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <id>hjosugi</id>
            <name>hjosugi</name>
            <url>https://github.com/hjosugi</url>
        </developer>
    </developers>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/hjosugi/spring-chat/issues</url>
    </issueManagement>

    <modules>
        <module>spring-chat-spring-boot-autoconfigure</module>
        <module>spring-chat-spring-boot-starter</module>
        <module>spring-chat-kotlin</module>
        <module>spring-chat-sample-webmvc</module>
        <module>spring-chat-sample-webflux</module>
        <module>spring-chat-sample-kotlin</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>2.1.0</spring-ai.version>
        <deep-chat.version>2.5.1</deep-chat.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.hjosugi</groupId>
                <artifactId>spring-chat-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hjosugi</groupId>
                <artifactId>spring-chat-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.hjosugi</groupId>
                <artifactId>spring-chat-kotlin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.webjars.npm</groupId>
                <artifactId>deep-chat</artifactId>
                <version>${deep-chat.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Spring Boot's parent already manages this plugin: its version is kotlin.version, the Kotlin
                  that Boot's BOM manages, and it has the compile and test-compile executions. A Kotlin module
                  declares the plugin and its source directories. What is stated here is what the build relies
                  on: the class files target the Java that the chat supports, as the Java modules do.
                -->
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <configuration>
                        <jvmTarget>${java.version}</jvmTarget>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
              The test classes run side by side; the tests inside one class still run one after
              the other, because a class keeps its own state (a stand-in for the model's API, a
              Spring context). Every class starts its servers on a random port and changes no
              system property, so the classes do not meet.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <properties>
                        <configurationParameters>
                            junit.jupiter.execution.parallel.enabled = true
                            junit.jupiter.execution.parallel.mode.default = same_thread
                            junit.jupiter.execution.parallel.mode.classes.default = concurrent
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          What Maven Central asks of a release: a jar of the sources and one of the Javadoc,
          a signature for every file, and an upload to the Central Portal. The upload is left
          for the person who publishes to confirm in the portal. Run it on a tagged release:

              ./mvnw -Prelease deploy

          It needs a server "central" in settings.xml, with the user token of the Central
          Portal, and a GPG key. See RELEASING.md.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- The upload waits in the portal until it is published there. -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          The tests on virtual threads: the web server's, and Reactor's boundedElastic, which
          the chat uses for what blocks. jdk.tracePinnedThreads prints a stack trace when a
          virtual thread blocks while it holds its carrier thread.
        -->
        <profile>
            <id>virtual-threads</id>
            <properties>
                <argLine>-Dspring.threads.virtual.enabled=true -Dreactor.schedulers.defaultBoundedElasticOnVirtualThreads=true -Djdk.tracePinnedThreads=full</argLine>
            </properties>
        </profile>
    </profiles>
</project>

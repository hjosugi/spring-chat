<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.hjosugi</groupId>
        <artifactId>spring-chat-parent</artifactId>
        <version>0.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>spring-chat-kotlin</artifactId>
    <name>spring-chat-kotlin</name>
    <description>Kotlin extensions for spring-chat: a reply as a Flow, and its text from a suspend function</description>

    <properties>
        <dokka.version>2.3.0</dokka.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.hjosugi</groupId>
            <artifactId>spring-chat-spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- The versions are Spring Boot's: its BOM manages Kotlin and kotlinx.coroutines. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <!-- A library declares its public API: no visibility or type is left to be inferred. -->
                    <execution>
                        <id>compile</id>
                        <configuration>
                            <args>
                                <arg>-Xexplicit-api=strict</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Maven Central wants a Javadoc jar. The Maven Javadoc plugin of the parent's release profile reads
          Java sources, finds none here, and succeeds without a jar, so Dokka writes this one: its javadocJar
          goal turns the KDoc into Javadoc-style HTML and attaches the jar, which the GPG plugin then signs
          with the other files of the module.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jetbrains.dokka</groupId>
                        <artifactId>dokka-maven-plugin</artifactId>
                        <version>${dokka.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>javadocJar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>org.jetbrains.dokka</groupId>
                                <artifactId>javadoc-plugin</artifactId>
                                <version>${dokka.version}</version>
                            </dependency>
                            <!--
                              Dokka's Javadoc plugin brings Kotlin's standard library 2.0.21, older than the
                              compiler that Dokka's analysis embeds: without this, the build fails with
                              NoSuchMethodError: SequencesKt.sequenceOf(Object), in the Kotlin compiler's code.
                            -->
                            <dependency>
                                <groupId>org.jetbrains.kotlin</groupId>
                                <artifactId>kotlin-stdlib</artifactId>
                                <version>${kotlin.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

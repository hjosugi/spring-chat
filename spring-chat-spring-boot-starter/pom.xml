<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.hjosugi</groupId>
        <artifactId>spring-chat-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <!-- Only dependencies: the code is in spring-chat-spring-boot-autoconfigure. -->
    <artifactId>spring-chat-spring-boot-starter</artifactId>
    <name>spring-chat-spring-boot-starter</name>
    <description>Starter for an AI chat page and Thymeleaf fragment, on Spring MVC or WebFlux</description>

    <dependencies>
        <dependency>
            <groupId>io.github.hjosugi</groupId>
            <artifactId>spring-chat-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- The chat UI, a web component. The locator serves it without the version in the URL. -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>deep-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Maven Central wants a jar of sources and one of Javadoc for every jar, and this one
          has no code: they are empty.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <configuration>
                            <forceCreation>true</forceCreation>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>empty-javadoc-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <forceCreation>true</forceCreation>
                                    <skipIfEmpty>false</skipIfEmpty>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
